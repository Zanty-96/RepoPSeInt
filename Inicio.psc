//realizar un algoritmo que pida identificacion, nombres apellidos, edad, fecha de nacimiento, correo, telefono de una persona y mostrar detalle en pantalla 
Algoritmo Inicio
	Definir iden, nom, ape, edad, fecnaci, correo, tel Como Caracter
	Escribir "ingrese identificacion"
	Leer iden
	Escribir "ingrese nombre"
	Leer nom
	Escribir "ingrese apellidos"
	Leer ape
	Escribir "ingrese edad"
	Leer edad
	Escribir "fecha de nacimiento"
	Leer fecnaci
	Escribir "ingrese correo electronico"
	Leer correo
	Escribir "ingrese numero celular"
	Leer tel
	Imprimir "su identidad es: ", iden
	Imprimir "su nombre es: ", nom,  " su apellido es: ", ape
	Imprimir "su edad es: ", edad 
	Imprimir "su fecha de nacimiento: ", fecnaci
	Imprimir "su correo es: ", correo
	Imprimir "su telefono es: ", tel
FinAlgoritmo
